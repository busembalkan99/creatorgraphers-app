# Bu dosyayı .env.local adıyla kopyala ve iki değeri Supabase'den doldur.
# publishable anahtar tarayıcıda zaten görünür, gizli değildir; yine de depoya konmaz.
# service_role anahtarını ASLA buraya yazma.
VITE_SUPABASE_URL=https://PROJE-KIMLIGI.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bildirimler (karar 120): VAPID açık anahtarı. Adı gibi açık, tarayıcıya gidiyor; gizli eşi yalnız Supabase secrets'ta.
# Boş bırakılırsa bildirim kartı ve anahtar "desteklenmiyor" gösterir.
VITE_VAPID_ACIK=
